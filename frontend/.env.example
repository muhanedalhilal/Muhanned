# ============================================================
# Massar Frontend — Environment Variables Template
# Copy this file to .env.development (or .env.production)
# and fill in your own values.
# NEVER commit real .env files to version control.
# ============================================================

# URL of your running backend API
# Local development:
VITE_API_URL=http://localhost:8000

# Production (replace with your Render/Railway backend URL):
# VITE_API_URL=https://your-backend.onrender.com

# Optional: override Supabase credentials (otherwise defaults are in src/services/supabase.js)
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
