# ============================================================
# Massar Backend — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API

# Your project's public URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / public key (safe to use on the client)
SUPABASE_KEY=your_supabase_anon_public_key_here

# Service role secret key (server-side only, never expose to clients)
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key_here

# ── Database ─────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── AI ───────────────────────────────────────────────────────
# From: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS ─────────────────────────────────────────────────────
# Set to your frontend URL (e.g. http://localhost:5173 for local dev)
FRONTEND_URL=http://localhost:5173
