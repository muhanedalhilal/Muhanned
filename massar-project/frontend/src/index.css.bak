.home-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px 80px 20px;
  position: relative;
  z-index: 5;
}

.hero-section {
  text-align: center;
  margin-bottom: 20px;
  z-index: 10;
}

.hero-title {
  font-size: 48px;
  font-weight: 800;
  background: linear-gradient(135deg, #ffffff 0%, #94a3b8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 15px;
}

.hero-subtitle {
  font-size: 18px;
  color: #94a3b8;
  max-width: 600px;
  margin: 0 auto 25px auto;
  line-height: 1.5;
}

.growth-blossom-container {
  width: 100%;
  max-width: 1000px;
  height: 550px;
  margin: 40px auto 120px auto;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.blossom-petal {
  position: absolute;
  width: 320px;
  transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  z-index: 50;
}

.petal-glass {
  background: rgba(15, 23, 42, 0.98);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 40px 40px 10px 40px; 
  padding: 35px;
  display: flex;
  align-items: center;
  gap: 20px;
  box-shadow: 0 40px 100px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255,255,255,0.2);
  position: relative;
}

.petal-glass:hover {
  transform: scale(1.1) translateY(-10px);
  background: #111827;
  border-color: #60a5fa;
  box-shadow: 0 50px 120px rgba(0,0,0,0.9);
}

.petal-glass::before {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 8px; height: 100%;
  background: #60a5fa;
  border-radius: 40px 0 0 40px;
}

.p-icon { 
  color: #60a5fa; 
  flex-shrink: 0; 
  width: 32px !important; 
  height: 32px !important;
  filter: drop-shadow(0 0 10px rgba(96, 165, 250, 0.6)); 
}

.p-text h5 { 
  color: #ffffff !important; 
  font-size: 20px; 
  font-weight: 900; 
  margin-bottom: 8px; 
  letter-spacing: -0.5px;
}

.p-text p { 
  color: #e2e8f0 !important; 
  font-size: 16px; 
  line-height: 1.5; 
  margin: 0; 
  font-weight: 500;
  opacity: 1 !important;
}

/* Original Stable Alignment */
.petal-top-left { top: 0; left: 50px; }
.petal-top-right { top: 0; right: 50px; border-radius: 40px 40px 40px 10px; }
.petal-top-right .petal-glass::before { left: auto; right: 0; background: #c084fc; border-radius: 0 40px 40px 0; }

.petal-bot-left { bottom: 0; left: 50px; border-radius: 40px 10px 40px 40px; }
.petal-bot-left .petal-glass::before { background: #34d399; }

.petal-bot-right { bottom: 0; right: 50px; border-radius: 10px 40px 40px 40px; }
.petal-bot-right .petal-glass::before { left: auto; right: 0; background: #f472b6; border-radius: 0 40px 40px 0; }
